const greeting: string = "hello"

struct Label {
    text: string
    note: string
}

struct Pair(first: string, second: string) {}

fn echo(s: string): string {
    return s
}

fn build(n: int): string {
    let acc = ""
    let i = 0
    while (i < n) {
        acc = acc + "x"
        i = i + 1
    }
    return acc
}

fn main(): void {
    let a = "alpha"
    assert(a == "alpha")
    assert(greeting == "hello")
    assert(greeting.len() == 5)

    let b = "one"
    b = "two"
    b = "one"
    assert(b == "one")

    // Borrowed into a call that only reads, and returned back out.
    assert(echo("borrowed") == "borrowed")
    assert(echo(a) == "alpha")

    let l = Label { text: "t", note: "n" }
    assert(l.text == "t")
    assert(l.note == "n")
    let p = Pair("t", "n")
    assert(p.first == l.text)
    assert(p.second == "n")

    let arr: string[] = ["first", "second", a]
    assert(arr.len() == 3)
    assert(arr[0] == "first")
    assert(arr[2] == "alpha")
    assert(arr.indexOf("second") == 1)

    // A map key is read-only, a map value is owned.
    let m: map[string, int] = {}
    m["k"] = 1
    assert(m["k"] == 1)
    assert(m.has("k"))

    assert(build(0) == "")
    assert(build(1) == "x")
    assert(build(5) == "xxxxx")

    let joined = "pre-" + a + "-post"
    assert(joined == "pre-alpha-post")
    assert(("" + a) == "alpha")

    let opt: string? = "present"
    assert(opt != null)

    let empty = ""
    assert(empty == "")
    assert(empty.len() == 0)
    assert(empty.isEmpty())
}
