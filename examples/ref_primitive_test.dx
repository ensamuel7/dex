import "fmt"

fn increment(n: &int): void {
    n = n + 1
}

fn double_it(d: &double): void {
    d = d * 2.0
}

fn toggle(b: &bool): void {
    b = !b
}

fn main(): void {
    let x: int = 5
    increment(x)
    assert(x == 6)

    let pi: double = 3.14
    double_it(pi)
    assert(pi > 6.2)

    let flag: bool = true
    toggle(flag)
    assert(flag == false)

    fmt.println("All primitive ref tests passed")
}
