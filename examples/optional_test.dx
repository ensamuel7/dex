import "fmt"

struct OptPoint {
    x: int
    label: string
}

fn makePoint(x: int): OptPoint? {
    if (x < 0) {
        return null
    }
    return OptPoint { x: x, label: "p" + x }
}

fn testIntOptionalNull(): void {
    let x: int?
    assert(x == null)
}

fn testIntOptionalValue(): void {
    let x: int? = 5
    assert(x != null)
    if (x != null) {
        assert(x == 5)
    }
}

fn testStringOptionalNull(): void {
    let s: string? = null
    assert(s == null)
}

fn testStringOptionalValue(): void {
    let s: string? = "hello"
    assert(s != null)
    if (s != null) {
        assert(s == "hello")
    }
}

fn testReassignToNull(): void {
    let x: int? = 5
    assert(x != null)
    x = null
    assert(x == null)
}

fn testReassignFromNull(): void {
    let x: int? = null
    assert(x == null)
    x = 42
    assert(x != null)
    if (x != null) {
        assert(x == 42)
    }
}

fn testBoolOptional(): void {
    let b: bool? = true
    assert(b != null)
    if (b != null) {
        assert(b == true)
    }
    b = null
    assert(b == null)
}

fn testDoubleOptional(): void {
    let d: double? = 3.14
    assert(d != null)
    d = null
    assert(d == null)
}

fn maybeInt(flag: bool): int? {
    if (flag) {
        return 42
    }
    return null
}

fn testFunctionReturningOptional(): void {
    let a: int? = maybeInt(true)
    assert(a != null)
    if (a != null) {
        assert(a == 42)
    }

    let b: int? = maybeInt(false)
    assert(b == null)
}

fn maybeString(flag: bool): string? {
    if (flag) {
        return "yes"
    }
    return null
}

fn testFunctionReturningStringOptional(): void {
    let a: string? = maybeString(true)
    assert(a != null)
    if (a != null) {
        assert(a == "yes")
    }

    let b: string? = maybeString(false)
    assert(b == null)
}

fn testReversedNullCheck(): void {
    let x: int? = 10
    if (null != x) {
        assert(x == 10)
    }
}

fn showOptional(val: int?): bool {
    if (val != null) {
        return true
    }
    return false
}

fn testOptionalParam(): void {
    assert(showOptional(5) == true)
    assert(showOptional(null) == false)
}

fn testLongOptional(): void {
    let l: long? = 1000000
    assert(l != null)
    if (l != null) {
        assert(l == 1000000)
    }
    l = null
    assert(l == null)
}

fn testStringReassign(): void {
    let s: string? = "first"
    assert(s != null)
    s = "second"
    assert(s != null)
    if (s != null) {
        assert(s == "second")
    }
    s = null
    assert(s == null)
}

fn main(): void {
    testIntOptionalNull()
    testIntOptionalValue()
    testStringOptionalNull()
    testStringOptionalValue()
    testReassignToNull()
    testReassignFromNull()
    testBoolOptional()
    testDoubleOptional()
    testFunctionReturningOptional()
    testFunctionReturningStringOptional()
    testReversedNullCheck()
    testOptionalParam()
    testLongOptional()
    testStringReassign()
    fmt.println("All optional tests passed!")

    let some: OptPoint? = makePoint(3)
    assert(some != null)
    if (some != null) {
        assert(some.x == 3)
        assert(some.label == "p3")
    }
    let none: OptPoint? = makePoint(-1)
    assert(none == null)
}
