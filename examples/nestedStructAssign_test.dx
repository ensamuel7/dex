import "fmt"
import "str"

struct Index {
    key: string
    values: string[]
}

struct Headers {
    raw: string
    index: Index
}

struct Page {
    ok: bool
    url: string
    headers: Headers
    hops: string[]
}

fn make(ok: bool, tag: string): Page {
    let values: string[] = ["a-" + tag, "b-" + tag]
    let hops: string[] = ["hop-" + tag]
    return Page {
        ok: ok,
        url: "https://" + tag,
        headers: Headers { raw: "Server: " + tag, index: Index { key: "server-" + tag, values: values } },
        hops: hops
    }
}

fn main(): void {
    let secure: Page = make(false, "secure")
    let plain: Page = make(true, "plain")

    let page: Page = secure
    assert(page.headers.index.key == "server-secure")

    if (!secure.ok) {
        page = plain
    }

    assert(page.ok)
    assert(page.url == "https://plain")
    assert(page.headers.raw == "Server: plain")
    assert(page.headers.index.key == "server-plain")
    assert(page.headers.index.values.len() == 2)
    assert(page.headers.index.values[0] == "a-plain")
    assert(page.hops[0] == "hop-plain")

    assert(plain.headers.raw == "Server: plain")
    assert(plain.headers.index.key == "server-plain")
    assert(plain.headers.index.values[1] == "b-plain")

    assert(secure.headers.index.key == "server-secure")
    assert(secure.headers.raw == "Server: secure")

    page = secure
    assert(page.headers.index.key == "server-secure")
    assert(plain.headers.index.key == "server-plain")

    fmt.println("nested struct assignment: ok")
}
