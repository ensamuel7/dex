import "fmt"
import "str"

struct Inner {
    tag: string
}

struct Holder {
    id: string
    items: Inner[]
    inner: Inner
}

struct Plain {
    count: int
    ratio: double
}

fn noItems(): Inner[] {
    let out: Inner[] = []
    return out
}

fn build(): Holder[] {
    let items: Inner[] = noItems()
    let a: Inner = Inner { tag: "A" }
    items.push(a)
    let b: Inner = Inner { tag: "B" }
    items.push(b)
    let core: Inner = Inner { tag: "core" }
    let one: Holder = Holder { id: "H1", items: items, inner: core }
    let all: Holder[] = []
    all.push(one)
    return all
}

fn fromOwnArray(): Holder {
    let all: Holder[] = build()
    return all[0]
}

fn fromCallersArray(all: Holder[]): Holder {
    return all[0]
}

fn innerOfOwn(): Inner {
    let all: Holder[] = build()
    let holder: Holder = all[0]
    return holder.inner
}

fn innerOfCallers(holder: Holder): Inner {
    return holder.inner
}

// A whole by-value parameter handed straight back.
fn passedThrough(holder: Holder): Holder {
    return holder
}

// The same, from a function with a heap local of its own: the cleanup that
// releases the local must not take the parameter's fields with it.
fn stamped(holder: Holder, at: int): Holder {
    let note: string = "at " + str.fromInt(at)
    assert(note.len() > 0)
    return holder
}

fn plainOf(values: Plain[]): Plain {
    return values[0]
}

fn main(): void {
    // Out of an array the callee owned.
    let own: Holder = fromOwnArray()
    assert(own.id == "H1")
    let ownItems: Inner[] = own.items
    assert(ownItems.len() == 2)
    let ownFirst: Inner = ownItems[0]
    assert(ownFirst.tag == "A")
    assert(own.inner.tag == "core")

    let container: Holder[] = build()
    let borrowed: Holder = fromCallersArray(container)
    assert(borrowed.id == "H1")
    let borrowedItems: Inner[] = borrowed.items
    assert(borrowedItems.len() == 2)
    let borrowedSecond: Inner = borrowedItems[1]
    assert(borrowedSecond.tag == "B")

    // A nested struct field, from each side.
    let fromOwn: Inner = innerOfOwn()
    assert(fromOwn.tag == "core")
    let source: Holder = fromOwnArray()
    let fromCaller: Inner = innerOfCallers(source)
    assert(fromCaller.tag == "core")

    // A parameter returned whole.
    let through: Holder = passedThrough(source)
    assert(through.id == "H1")
    let throughItems: Inner[] = through.items
    assert(throughItems.len() == 2)

    let keptId: string = ""
    for (let i: int = 0; i < 50; i++) {
        let fresh: Holder = fromOwnArray()
        let back: Holder = stamped(fresh, i)
        keptId = back.id
    }
    assert(keptId == "H1")

    // Plain data, which needs no retain and must still work.
    let plains: Plain[] = []
    let p: Plain = Plain { count: 3, ratio: 0.5 }
    plains.push(p)
    let got: Plain = plainOf(plains)
    assert(got.count == 3)

    let rounds: int = 0
    let total: int = 0
    while (rounds < 200) {
        let each: Holder = fromOwnArray()
        let items: Inner[] = each.items
        total = total + items.len()
        let viaParam: Holder = fromCallersArray(container)
        let paramItems: Inner[] = viaParam.items
        total = total + paramItems.len()
        rounds = rounds + 1
    }
    assert(total == 800)
    fmt.println("returned " + str.fromInt(total) + " items through borrowed struct returns")
}
