import "fmt"

struct Stmt {
    table: string
    cols: string
    conds: string
    lim: int

    fn into(name: string): &Stmt {
        self.table = name
        return self
    }

    fn col(name: string): &Stmt {
        if (self.cols.isEmpty()) {
            self.cols = name
        } else {
            self.cols = self.cols + ", " + name
        }
        return self
    }

    fn where(cond: string): &Stmt {
        self.conds = cond
        return self
    }

    fn limit(n: int): &Stmt {
        self.lim = n
        return self
    }

    fn text(): string {
        let sb = StringBuilder()
        sb.append("INSERT INTO ")
        sb.append(self.table)
        sb.append(" (")
        sb.append(self.cols)
        sb.append(") WHERE ")
        sb.append(self.conds)
        return sb.toString()
    }
}

fn blank(): Stmt {
    return Stmt { table: "", cols: "", conds: "", lim: 0 }
}

fn insertInto(name: string): Stmt {
    return Stmt { table: name, cols: "", conds: "", lim: 0 }
}

struct Counter {
    n: int
    fn bump(): &Counter {
        self.n = self.n + 1
        return self
    }
}

fn main(): void {
    let s: Stmt = blank()
    s.into("users").col("id").col("email").col("name").where("active = true").limit(25)
    assert(s.table == "users")
    assert(s.cols == "id, email, name")
    assert(s.lim == 25)
    fmt.println(s.text())

    fmt.println(insertInto("posts").col("title").col("views").text())

    let c: Counter = Counter { n: 0 }
    c.bump().bump().bump()
    assert(c.n == 3)

    let r: &Counter = c.bump()
    assert(c.n == 4)
    assert(r.n == 4)

    assert(c.n == 4)

    let i: int = 0
    let total: int = 0
    while (i < 2000) {
        let b: Stmt = blank()
        b.into("t").col("a").col("b").where("x = 1").limit(i)
        total = total + b.text().len()
        total = total + insertInto("u").col("c").text().len()
        i = i + 1
    }
    fmt.println(total)
}
