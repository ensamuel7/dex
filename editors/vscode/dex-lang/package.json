{
  "name": "dex-lang",
  "displayName": "Dex Language",
  "description": "DexLang for VS Code: highlighting, diagnostics, completion, go to definition, formatting, snippets, and run/build/test commands",
  "version": "0.9.38",
  "publisher": "DexLang",
  "icon": "icons/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ensamuel7/dex"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "dex",
        "aliases": [
          "Dex",
          "dex",
          "DexLang"
        ],
        "extensions": [
          ".dx"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/dex-icon-light.svg",
          "dark": "./icons/dex-icon-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "dex",
        "scopeName": "source.dex",
        "path": "./syntaxes/dex.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "dex",
        "path": "./snippets/dex.json"
      }
    ],
    "commands": [
      {
        "command": "dex.run",
        "title": "Run File",
        "category": "Dex",
        "icon": "$(play)"
      },
      {
        "command": "dex.build",
        "title": "Build File",
        "category": "Dex",
        "icon": "$(package)"
      },
      {
        "command": "dex.test",
        "title": "Test File",
        "category": "Dex",
        "icon": "$(beaker)"
      },
      {
        "command": "dex.testAll",
        "title": "Run All Tests",
        "category": "Dex"
      },
      {
        "command": "dex.dev",
        "title": "Run File and Rerun on Change",
        "category": "Dex"
      },
      {
        "command": "dex.lint",
        "title": "Lint File",
        "category": "Dex"
      },
      {
        "command": "dex.showVersion",
        "title": "Show Compiler Version",
        "category": "Dex"
      },
      {
        "command": "dex.restartServer",
        "title": "Restart Language Server",
        "category": "Dex"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "dex.run",
          "when": "resourceLangId == dex",
          "group": "navigation@1"
        },
        {
          "command": "dex.test",
          "when": "resourceLangId == dex && resourceFilename =~ /_test\\.dx$/",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "dex.run",
          "when": "resourceLangId == dex",
          "group": "dex@1"
        },
        {
          "command": "dex.build",
          "when": "resourceLangId == dex",
          "group": "dex@2"
        },
        {
          "command": "dex.test",
          "when": "resourceLangId == dex && resourceFilename =~ /_test\\.dx$/",
          "group": "dex@3"
        }
      ],
      "explorer/context": [
        {
          "command": "dex.run",
          "when": "resourceLangId == dex",
          "group": "dex@1"
        },
        {
          "command": "dex.build",
          "when": "resourceLangId == dex",
          "group": "dex@2"
        }
      ],
      "commandPalette": [
        {
          "command": "dex.run",
          "when": "resourceLangId == dex"
        },
        {
          "command": "dex.build",
          "when": "resourceLangId == dex"
        },
        {
          "command": "dex.test",
          "when": "resourceLangId == dex"
        },
        {
          "command": "dex.dev",
          "when": "resourceLangId == dex"
        },
        {
          "command": "dex.lint",
          "when": "resourceLangId == dex"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dex.run",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "editorLangId == dex"
      }
    ],
    "configuration": {
      "title": "Dex",
      "properties": {
        "dex.path": {
          "type": "string",
          "default": "dex",
          "description": "Path to the dex binary. Defaults to 'dex' (must be in PATH)."
        }
      }
    },
    "configurationDefaults": {
      "[dex]": {
        "editor.formatOnSave": true,
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.defaultFormatter": "DexLang.dex-lang"
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.3.0"
  }
}
