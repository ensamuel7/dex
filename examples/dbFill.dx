import "fmt"
import "db"
import "str"
import "reflect"

struct Person {
    id: long
    name: string
    age: int
    score: double
    active: bool
    tags: string[]
    note: string
}

fn main(): void {
    let conn: int = db.open("sqlite", "/tmp/dexfill.db")
    if (conn == -1) {
        fmt.println("no sqlite — skipping")
        return
    }

    db.exec(conn, "DROP TABLE IF EXISTS people")
    db.exec(
        conn,
        "CREATE TABLE people (id INTEGER, name TEXT, age INTEGER, score REAL, active INTEGER, tags TEXT, note TEXT)"
    )
    db.exec(conn, "INSERT INTO people VALUES (9007199254740993, 'Ada', 36, 1.5, 1, 'x,y', 'hello')")

    let r: int = 0
    while (r < 300) {
        let rows: int = db.query(conn, "SELECT id, name, age, score, active, tags, note FROM people")
        while (db.next(rows)) {
            let p: Person = Person { id: 0, name: "seed", age: 0, score: 0.0, active: false, tags: [], note: "seed" }
            db.fill(p, rows)
            assert(p.id == 9007199254740993)
            assert(p.name == "Ada")
            assert(p.age == 36)
            assert(p.score == 1.5)
            assert(p.active)
            assert(p.note == "hello")
            assert(reflect.fieldKind(p, 5) == "array")
        }

        db.free(rows)
        r = r + 1
    }

    db.close(conn)
    fmt.println("300 rows filled, no field named twice")
}
