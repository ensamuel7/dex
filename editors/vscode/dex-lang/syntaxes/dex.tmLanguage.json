{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Dex",
  "scopeName": "source.dex",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#function-definition" },
    { "include": "#import-statement" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#module-call" },
    { "include": "#function-call" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.dex",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.dex",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.dex",
              "match": "\\\\[\"\\\\nt]"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.dex",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "function-definition": {
      "patterns": [
        {
          "match": "\\b(fn|function)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.fn.dex" },
            "2": { "name": "entity.name.function.dex" }
          }
        }
      ]
    },
    "import-statement": {
      "patterns": [
        {
          "match": "\\b(import)\\s+(\"[^\"]*\")",
          "captures": {
            "1": { "name": "keyword.control.import.dex" },
            "2": { "name": "string.quoted.double.dex" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.dex",
          "match": "\\b(if|else|while|return)\\b"
        },
        {
          "name": "keyword.other.fn.dex",
          "match": "\\b(fn|function)\\b"
        },
        {
          "name": "keyword.other.let.dex",
          "match": "\\blet\\b"
        },
        {
          "name": "keyword.control.import.dex",
          "match": "\\bimport\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.dex",
          "match": "\\b(i32|bool|string|void)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.dex",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "module-call": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\.([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.namespace.dex" },
            "2": { "name": "entity.name.function.dex" }
          }
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.dex" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.dex",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.dex",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic.dex",
          "match": "[+\\-*/]"
        },
        {
          "name": "keyword.operator.assignment.dex",
          "match": "="
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.colon.dex",
          "match": ":"
        },
        {
          "name": "punctuation.separator.comma.dex",
          "match": ","
        },
        {
          "name": "punctuation.accessor.dot.dex",
          "match": "\\."
        }
      ]
    }
  }
}
