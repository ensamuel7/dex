import "crypto"
import "fmt"

fn main(): void {
    let secret: string = "twelve-dollar-challenge"

    let signingInput: string =
        "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9." +
        "eyJzdWIiOiIxIiwidXNlcm5hbWUiOiJnb2xkZW5fZW1iZXJfMSIsImlhdCI6MTc2MDAwMDAwMCwiZXhwIjoxNzYwMDAzNjAwfQ"
    let sig: string = crypto.hmacSha256B64Url(secret, signingInput)
    assert(sig == "cwzJrot3uVQhgRkwF46jBFVRM-zpa81nzYTlZDRQ5aA")

    assert(sig.len() == 43)
    assert(!sig.contains("="))
    assert(!sig.contains("+"))
    assert(!sig.contains("/"))

    assert(crypto.hmacSha256B64Url(secret, "") == "4c-vGtC3uElckIDV8bzLapV1uqN5e1y5u0A_KZLdMa0")
    assert(crypto.hmacSha256B64Url(secret, "a") == "U_SHc6P11l95fQU_vNu15l5-Dt8YgwmBGk6su74bm_o")
    assert(crypto.hmacSha256B64Url(secret, "ab") == "FY62fNPz7KiI3qCbAUnERFO5Kbc3hmMCdh8k7EVzdaA")
    assert(crypto.hmacSha256B64Url(secret, "abc") == "cKcSs_wlTuxW_AV8_3UC3JnAieYpHy93QzBhPUTTKlU")
    assert(crypto.hmacSha256B64Url(secret, "hello world") == "EqWg7k_REJB-gy4BDDnWmDFjRQrHhfaI0eTIOW-Sizs")

    assert(crypto.hmacSha256B64Url("other-secret", signingInput) != sig)

    assert(crypto.secureEquals(sig, "cwzJrot3uVQhgRkwF46jBFVRM-zpa81nzYTlZDRQ5aA"))
    assert(!crypto.secureEquals(sig, "cwzJrot3uVQhgRkwF46jBFVRM-zpa81nzYTlZDRQ5aB"))

    fmt.println("HS256 signatures verify in the encoding the token uses")
}
