import "json"

struct EscRow {
    id: int
    text: string
}

fn main(): void {
    // A quote must become \" and not end the string early.
    let quoted: EscRow[] = [EscRow { id: 1, text: "say \"hi\"" }]
    assert(json.encode(quoted) == "[{\"id\":1,\"text\":\"say \\\"hi\\\"\"}]")

    // A backslash must double.
    let slashed: EscRow[] = [EscRow { id: 2, text: "a\\b" }]
    assert(json.encode(slashed) == "[{\"id\":2,\"text\":\"a\\\\b\"}]")

    let newline: EscRow[] = [EscRow { id: 3, text: "a\nb" }]
    assert(json.encode(newline) == "[{\"id\":3,\"text\":\"a\\nb\"}]")

    let tabbed: EscRow[] = [EscRow { id: 4, text: "a\tb" }]
    assert(json.encode(tabbed) == "[{\"id\":4,\"text\":\"a\\tb\"}]")

    let accented: EscRow[] = [EscRow { id: 5, text: "Simülatör" }]
    assert(json.encode(accented) == "[{\"id\":5,\"text\":\"Simülatör\"}]")

    // An empty string is a pair of quotes, not a null.
    let blank: EscRow[] = [EscRow { id: 6, text: "" }]
    assert(json.encode(blank) == "[{\"id\":6,\"text\":\"\"}]")

    let payload: EscRow[] = [EscRow { id: 7, text: "{\"a\": \"b\"}" }]
    assert(json.encode(payload) == "[{\"id\":7,\"text\":\"{\\\"a\\\": \\\"b\\\"}\"}]")

    let doc: json.Value = { items: payload }
    assert(json.encode(doc) == "{\"items\":[{\"id\":7,\"text\":\"{\\\"a\\\": \\\"b\\\"}\"}]}")

    // Round trip: decode must undo exactly what encode did.
    let back: EscRow[] = json.decode("[{\"id\":8,\"text\":\"q\\\"s\\\\b\\nl\\tt\"}]")
    assert(back.len() == 1)
    let row: EscRow = back[0]
    assert(row.text == "q\"s\\b\nl\tt")
    assert(json.encode(back) == "[{\"id\":8,\"text\":\"q\\\"s\\\\b\\nl\\tt\"}]")

    let ctrl: EscRow[] = json.decode("[{\"id\":9,\"text\":\"x\\u0001y\"}]")
    assert(ctrl.len() == 1)
    assert(json.encode(ctrl) == "[{\"id\":9,\"text\":\"x\\u0001y\"}]")
}
