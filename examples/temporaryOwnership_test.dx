// Values that are produced and then only read, with nothing binding them.
//
// A consumer that merely reads a value does not own it, so whoever produced it
// has to release it. Each shape below leaked one object per evaluation, and all
// of them are ordinary code rather than anything exotic.

import "fmt"
import "os"
import "str"

struct Target {
    ok: bool
    reason: string
}

fn refuse(reason: string): Target {
    return Target { ok: false, reason: reason }
}

fn accept(): Target {
    return Target { ok: true, reason: "" }
}

fn takesBorrowed(s: string): bool {
    return !s.isEmpty()
}

fn main(): void {
    // A field read off a struct that nothing binds. A struct owns its heap
    // fields, so the fields had nobody to release them.
    assert(!refuse("no").ok)
    assert(accept().ok)
    if (refuse("in a condition").ok) {
        assert(false)
    }
    let reason: string = refuse("read the field").reason
    assert(reason == "read the field")

    // A minted string as an argument that is only read, inside a condition.
    let name: string = "Alice"
    if (takesBorrowed(name.toLower())) {
        assert(true)
    }
    while (takesBorrowed(name.toLower()) && reason.len() > 0) {
        reason = ""
    }

    // A built string reaching a stdlib function that takes the bytes. What the
    // callee receives is a raw pointer, so it cannot own the string, and
    // reading .data off a minted value left it unreleased once per call.
    let key: string = "PATH" + ""
    let value: string = os.env(key)
    assert(value.len() >= 0)
    let built: string = os.env("HOME" + "")
    assert(built.len() >= 0)

    // A chain where every step mints, ending in something that only reads.
    let line: string = "  Content-Type: text/html  "
    assert(line.trim().toLower().startsWith("content-type"))
    let n: int = 0
    while (n < 3) {
        if (line.substring(0, 14).trim().toLower() == "content-type:") {
            n = n + 1
        } else {
            n = n + 1
        }
    }
    assert(n == 3)

    fmt.println("temporary ownership: ok")
}
