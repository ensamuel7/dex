import "str"

fn main(): void {
    let sb = StringBuilder()
    sb.append("hello")
    sb.append(" ")
    sb.append("world")
    let result: string = sb.toString()
    assert(result == "hello world")

    let sb2 = StringBuilder()
    sb2.append("n=")
    sb2.append(42)
    sb2.append(" pi=")
    sb2.append(3.14)
    sb2.append(" ok=")
    sb2.append(true)
    let poly: string = sb2.toString()
    assert(poly == "n=42 pi=3.14 ok=true")

    let sb3 = StringBuilder()
    assert(sb3.len() == 0)
    sb3.append("test")
    assert(sb3.len() == 4)
    sb3.clear()
    assert(sb3.len() == 0)

    let sb4 = StringBuilder()
    for (let i = 0; i < 100; i++) {
        sb4.append(str.fromInt(i))
        sb4.append(",")
    }
    let csv: string = sb4.toString()
    assert(csv.startsWith("0,1,2,"))
    assert(csv.endsWith("99,"))

    let sb5: StringBuilder = StringBuilder()
    sb5.append("typed")
    assert(sb5.toString() == "typed")
}
