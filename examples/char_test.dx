import "fmt"
import "num"

fn main(): void {
    let ch: char = 'A'
    assert(ch == 'A')

    let code: int = num.toInt(ch)
    assert(code == 65)

    assert('a' > 'A')
    assert('z' >= 'z')

    let newline: char = '\n'
    let tab: char = '\t'
    let backslash: char = '\\'
    let quote: char = '\''
    assert(newline == '\n')
    assert(tab == '\t')

    let rem: int = 'z' % 10
    assert(rem == 2)

    let chars: char[] = ['H', 'i']
    assert(chars[0] == 'H')
    assert(chars[1] == 'i')
    chars.push('!')
    assert(chars.len() == 3)

    fmt.println('X')

    let inferred = 'B'
    assert(inferred == 'B')
}
