import "str"

fn deepest(n: int): void throws {
    throw Exception("boom " + str.fromInt(n))
}

fn middle(n: int): void throws {
    let a = "local a " + str.fromInt(n)
    let b = "local b " + str.fromInt(n)
    deepest(n)
    assert(a != b)
}

fn passesATemporary(n: int): void throws {
    deepestWithArg("arg " + str.fromInt(n))
}

fn deepestWithArg(s: string): void throws {
    throw Exception(s)
}

fn guarded(n: int): int {
    try {
        return n * 2
    } catch (e: Exception) {
        return 0
    }
}

// A break out of a try body is the same jump.
fn breaksOut(limit: int): int {
    let seen = 0
    for (let i = 0; i < limit; i = i + 1) {
        try {
            if (i > 3) {
                break
            }

            seen = seen + 1
        } catch (e: Exception) {
            seen = 0
        }
    }

    return seen
}

fn returnsAThrow(fail: bool): int {
    try {
        return mightThrow(fail)
    } catch (e: Exception) {
        return -1
    }
}

fn mightThrow(fail: bool): int throws {
    if (fail) {
        throw Exception("from the return expression")
    }

    return 5
}

fn main(): void {
    let caught = 0
    for (let i = 0; i < 100; i = i + 1) {
        try {
            middle(i)
        } catch (e: Exception) {
            caught = caught + 1
        }
    }

    assert(caught == 100)

    let temps = 0
    for (let i = 0; i < 100; i = i + 1) {
        try {
            passesATemporary(i)
        } catch (e: Exception) {
            temps = temps + 1
        }
    }

    assert(temps == 100)

    let total = 0
    for (let i = 0; i < 200; i = i + 1) {
        total = total + guarded(i)
    }

    assert(total == 39800)

    assert(breaksOut(10) == 4)

    assert(returnsAThrow(false) == 5)
    assert(returnsAThrow(true) == -1)

    let last = ""
    try {
        throw Exception("final")
    } catch (e: Exception) {
        last = e.message
    }

    assert(last == "final")
}
