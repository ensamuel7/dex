import "os"
import "fmt"

fn main(): void {
    let path: string = os.env("PATH")
    assert(path != "")
    fmt.println("PATH is set")

    let result: ExecResult = os.exec("echo hello")
    assert(result.exitCode == 0)
    assert(result.output == "hello\n")
    fmt.println("os.exec works")

    let unset: string = os.env("DEX_NONEXISTENT_VAR_12345")
    assert(unset == "")
    fmt.println("os.env returns empty for unset vars")

    fmt.println("All os tests passed")
}
