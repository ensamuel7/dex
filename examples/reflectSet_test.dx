// Writing a struct's fields by position: reflect.setInt, setLong, setDouble,
// setBool and setString.
//
// These are the as* accessors with the assignment the other way round, and they
// exist for the shape that motivated them — filling a struct from a result set,
// a form, or any source that hands over values in declaration order, without
// writing one assignment per field per struct.
//
// A write carries one obligation a read does not. A struct owns its string
// fields, so setString releases whatever the field held and takes a reference
// to what replaced it. Everything here loops hard for that reason: a missing
// release leaks and a missing retain frees a string the struct still points at,
// and neither shows up in a single pass.
//
// The subject rules are stricter than a getter's, and deliberately so — see the
// three cases the checker refuses, listed at the bottom of this file.
import "fmt"
import "reflect"
import "str"

struct Pending {
    sessions: int
    energyWh: long
    rate: double
    settled: bool
    currency: string
    firstAt: string
}

struct Inner {
    label: string
    n: int
}

struct Outer {
    tag: string
    detail: Inner
}

// The whole point: one loop that fills any Pending, driven by the struct's own
// field kinds rather than by a list of field names written out beside it.
//
// It takes its subject as &Pending. A by-value parameter would be a copy that
// shares the caller's string pointers without owning them, so writing one would
// release a reference the caller still holds — the checker refuses it.
fn fill(out: &Pending, seed: int): void {
    let i: int = 0
    while (i < reflect.fieldCount(out)) {
        let kind: string = reflect.fieldKind(out, i)
        if (kind == "int") {
            assert(reflect.setInt(out, i, seed))
        } else if (kind == "long") {
            assert(reflect.setLong(out, i, 1000))
        } else if (kind == "double") {
            assert(reflect.setDouble(out, i, 1.5))
        } else if (kind == "bool") {
            assert(reflect.setBool(out, i, true))
        } else if (kind == "string") {
            // A value built for the call: the setter takes its own reference
            // and the temporary is released after the statement.
            assert(reflect.setString(out, i, reflect.fieldName(out, i) + "-" + str.fromInt(seed)))
        }
        i = i + 1
    }
}

fn main(): void {
    let p: Pending = Pending {}

    // Each setter writes its own kind and reports that it did.
    assert(reflect.setInt(p, 0, 7))
    assert(reflect.setLong(p, 1, 1234))
    assert(reflect.setDouble(p, 2, 2.5))
    assert(reflect.setBool(p, 3, true))
    assert(reflect.setString(p, 4, "GHS"))
    assert(p.sessions == 7)
    assert(p.energyWh == 1234)
    assert(p.rate == 2.5)
    assert(p.settled)
    assert(p.currency == "GHS")

    // A kind mismatch writes nothing and says so, rather than reinterpreting
    // the value — the field is simply not a case in that setter's switch.
    assert(!reflect.setLong(p, 4, 9))
    assert(p.currency == "GHS")
    assert(!reflect.setString(p, 0, "nope"))
    assert(p.sessions == 7)

    // An index computed out of range is refused rather than written off the end.
    let past: int = reflect.fieldCount(p) + 50
    assert(!reflect.setInt(p, past, 1))
    assert(!reflect.setString(p, past, "x"))

    // A name resolved at runtime reaches the same field as a literal one.
    let picked: string = "curr" + "ency"
    assert(reflect.setString(p, reflect.indexOf(p, picked), "USD"))
    assert(p.currency == "USD")

    // A nested struct is a subject in its own right.
    let o: Outer = Outer { tag: "t", detail: Inner { label: "before", n: 1 } }
    assert(reflect.setString(o.detail, 0, "after"))
    assert(reflect.setInt(o.detail, 1, 9))
    assert(o.detail.label == "after")
    assert(o.detail.n == 9)
    assert(o.tag == "t")

    // Overwriting a string field, over and over. The field starts out holding a
    // real string rather than a null, so every write has a previous reference to
    // release.
    let r: int = 0
    while (r < 400) {
        let q: Pending = Pending { sessions: 0, energyWh: 0, rate: 0.0, settled: false,
                                   currency: "seed", firstAt: "seed" }
        fill(q, r)
        assert(q.sessions == r)
        assert(q.energyWh == 1000)
        assert(q.rate == 1.5)
        assert(q.settled)
        assert(q.currency == "currency-" + str.fromInt(r))
        assert(q.firstAt == "firstAt-" + str.fromInt(r))
        r = r + 1
    }

    // Writing a field from a borrowed read of itself. The setter retains before
    // it releases, so the one reference is not dropped on the way through.
    assert(reflect.setString(p, 4, p.currency))
    assert(p.currency == "USD")

    fill(p, 42)
    fmt.println(p.currency + " / " + p.firstAt + " / " + str.fromInt(p.sessions))

    // What the checker refuses, and why:
    //
    //   fn bad(x: Pending) { reflect.setString(x, 4, "v") }
    //     a by-value struct parameter is a copy sharing the caller's string
    //     references — take it as &Pending instead
    //
    //   reflect.setString(list[0], 4, "v")
    //     the language has no way to mutate a struct array element in place
    //     (`list[0].currency = "v"` does not parse), and reflection is not a
    //     back door into it
    //
    //   reflect.setString(makePending(), 4, "v")
    //     a temporary owns its heap fields and nobody would release them
}
