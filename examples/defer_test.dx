import "str"

let order: string[] = []

fn note(s: string): void {
    order.push(s)
}

fn conditional(run: bool): void {
    if (run) {
        defer note("conditional")
    }

    note("body")
}

fn looped(): void {
    for (let i = 0; i < 3; i = i + 1) {
        defer note("iteration " + str.fromInt(i))
    }

    note("loop body done")
}

fn thrower(): void throws {
    throw Exception("boom")
}

fn unwound(): void throws {
    defer note("released")
    thrower()
    note("not reached")
}

// Most recent first, like every other defer.
fn ordered(): void {
    defer note("first registered")
    defer note("second registered")
    note("ordered body")
}

fn captures(n: int): void throws {
    let tag = "captured " + str.fromInt(n)
    defer note(tag)
    thrower()
}

fn main(): void {
    conditional(true)
    conditional(false)
    looped()
    try {
        unwound()
    } catch (e: Exception) {
        note("caught unwound")
    }

    ordered()
    try {
        captures(7)
    } catch (e: Exception) {
        note("caught captures")
    }

    let want: string[] = [
        "body",
        "conditional",
        "body",
        "loop body done",
        "iteration 2",
        "iteration 1",
        "iteration 0",
        "released",
        "caught unwound",
        "ordered body",
        "second registered",
        "first registered",
        "captured 7",
        "caught captures"
    ]

    assert(order.len() == want.len())
    foreach (want as i, expected) {
        assert(order[i] == expected)
    }
}
