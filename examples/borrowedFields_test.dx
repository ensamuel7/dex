import "str"

struct Rule {
    id: long
    name: string
    siteIds: long[]
}

struct Nested {
    tag: string
    rule: Rule
}

fn sites(a: long, b: long): long[] {
    let out: long[] = []
    out.push(a)
    out.push(b)
    return out
}

fn rules(): Rule[] {
    let out: Rule[] = []
    out.push(Rule { id: 1, name: "one", siteIds: sites(10, 11) })
    out.push(Rule { id: 2, name: "two", siteIds: sites(20, 21) })
    return out
}

fn churn(times: int): void {
    let junk: string[] = []
    let i: int = 0
    while (i < times) {
        junk.push("filler filler filler filler " + str.fromInt(i))
        i = i + 1
    }
}

fn main(): void {
    let rs: Rule[] = rules()
    let seen: int = 0
    let i: int = 0
    while (i < rs.len()) {
        let rule: Rule = rs[i]
        let ids: long[] = rule.siteIds
        assert(ids.len() == 2)
        seen = seen + ids.len()
        i = i + 1
    }

    assert(seen == 4)
    churn(500)

    let first: Rule = rs[0]
    let firstIds: long[] = first.siteIds
    assert(firstIds.len() == 2)
    assert(firstIds[0] == 10)
    assert(first.name == "one")
    churn(500)

    let copies: Rule[] = []
    let j: int = 0
    while (j < rs.len()) {
        let rule: Rule = rs[j]
        copies.push(Rule { id: rule.id, name: rule.name, siteIds: rule.siteIds })
        j = j + 1
    }

    churn(500)
    let copied: Rule = copies[1]
    let copiedIds: long[] = copied.siteIds
    assert(copiedIds.len() == 2)
    assert(copiedIds[1] == 21)
    assert(copied.name == "two")

    let bare: long[] = first.siteIds
    assert(bare.len() == 2)
    churn(500)
    assert(bare[1] == 11)

    let boxes: Nested[] = []
    boxes.push(Nested { tag: "boxed", rule: rs[0] })
    let box: Nested = boxes[0]
    let inner: Rule = box.rule
    let innerIds: long[] = inner.siteIds
    assert(innerIds.len() == 2)
    churn(500)
    assert(box.tag == "boxed")
    assert(inner.id == 1)

    let alias: Rule[] = rs
    assert(alias.len() == 2)
    churn(500)
    assert(rs.len() == 2)
}
