fn main(): void {
    let x = 42
    let y = 3.14
    let s = "hello"
    let b = true

    assert(x == 42)
    assert(y == 3.14)
    assert(b == true)

    let sum = x + 8
    assert(sum == 50)

    let arr = [1, 2, 3]
    assert(arr[0] == 1)
    assert(arr[1] == 2)
    assert(arr[2] == 3)

    for (let i = 0; i < 5; i++) {
        let doubled = i * 2
    }

    let counter = 0
    counter += 10
    counter -= 3
    assert(counter == 7)

    let n = 0
    n++
    n++
    n++
    assert(n == 3)
    n--
    assert(n == 2)
}
