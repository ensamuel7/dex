import "fmt"
import "time"

fn main(): void {
    let start: long = time.now_ns()
    let sum: long = 0
    for(let i: long = 0; i < 100000000; i++) {
        sum += i
    }
    let end: long = time.now_ns()
    let elapsed: long = (end - start) / 1000000
    fmt.print(sum)
    fmt.print(elapsed)
}
