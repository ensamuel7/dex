import "fmt"

struct User {
    name: string
    age: int

    fn greet(): string {
        return "Hi " + name
    }
}

struct Database {
    host: string
}

struct Service {
    db: &Database
}

fn updateName(user: &User): void {
    user.name = "updated"
}

fn getName(user: &User): string {
    return user.name
}

fn greetRef(user: &User): string {
    return user.greet()
}

fn getHost(db: &Database): string {
    return db.host
}

fn main(): void {
    let u = User { name: "alice", age: 30 }
    updateName(u)
    assert(u.name == "updated")

    let u2 = User { name: "bob", age: 25 }
    let n = getName(u2)
    assert(n == "bob")

    let u3 = User { name: "carol", age: 20 }
    let greeting = greetRef(u3)
    assert(greeting == "Hi carol")

    let db = Database { host: "localhost" }
    let svc = Service { db: db }
    let host = getHost(svc.db)
    assert(host == "localhost")

    fmt.println("All ref tests passed")
}
