import "fmt"

struct Point {
    x: int
    y: int
}

fn add_points(a: Point, b: Point): Point {
    let result: Point = Point { x: a.x + b.x, y: a.y + b.y }
    return result
}

fn main(): int {
    let p1: Point = Point { x: 10, y: 20 }
    let p2: Point = Point { x: 5, y: 15 }
    let p3: Point = add_points(p1, p2)
    fmt.println(p3.x)
    fmt.println(p3.y)
    p3.x = 100
    fmt.println(p3.x)
    return 0
}
