// DexLang Web Server Example
// Build: dex build examples/webserver.dx
// Run:   ./webserver
// Test:  curl http://localhost:8083/hello
//        curl http://localhost:8083/json
//        curl http://localhost:8083/html
import "http"
import "json"

fn handle_hello(): string {
  return "{\"message\": \"Hello, World!\"}"
}

fn handle_json(): HttpResponse {
  let body: string = json.new()
  body = json.set(body, "message", "Hello from Dex!")
  body = json.set(body, "number", 42)
  body = json.set(body, "success", true)
  return HttpResponse{statusCode: 200, body: body}
}

fn handle_html(): HttpResponse {
  return HttpResponse{statusCode: 200, body: "<h1>Hello from Dex!</h1>", contentType: "text/html"}
}

function getBinary(): long {
  return 010012001201
}

fn main(): void {
  http.route("GET", "/hello", handle_hello())
  http.route("GET", "/json", handle_json())
  http.route("GET", "/html", handle_html())
  http.route("GET", "/get-binary", getBinary())
  http.listen(8083)
}
