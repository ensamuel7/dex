import "fmt"

struct Point {
    x: int
}

struct Box {
    name: string?
    tags: string[]?
}

fn make(): Box {
    let n: string? = "a" + "b"
    let t: string[]? = ["x", "y"]
    return Box { name: n, tags: t }
}

fn nameLength(b: Box): int {
    let n: string? = b.name
    if (n == null) {
        return 0
    }
    return n.len()
}

fn tagCount(b: Box): int {
    let t: string[]? = b.tags
    if (t == null) {
        return 0
    }
    return t.len()
}

fn main(): void {
    let b: Box = make()
    let i: int = 0
    while (i < 100) {
        assert(nameLength(b) == 2)
        assert(tagCount(b) == 2)
        i = i + 1
    }
    let none: int[]? = []
    if (none != null) {
        none.push(3)
        assert(none.len() == 1)
    }
    let points: Point[]? = [Point { x: 1 }]
    if (points != null) {
        assert(points[0].x == 1)
    }

    let empty: Box = Box { name: null, tags: null }
    assert(nameLength(empty) == 0)
    assert(tagCount(empty) == 0)
    fmt.println("optionalFields_test: all assertions passed")
}
