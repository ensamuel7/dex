import "fmt"
import "db"

fn main(): void {
    let conn: int = db.open("mongo", "mongodb://localhost:27017/testdb")

    // Insert documents using database commands (JSON)
    db.exec(conn, "{\"insert\": \"users\", \"documents\": [{\"name\": \"Alice\", \"age\": 30}]}")
    db.exec(conn, "{\"insert\": \"users\", \"documents\": [{\"name\": \"Bob\", \"age\": 25}]}")

    // Query all documents from the users collection
    let rows: int = db.query(conn, "users")
    while (db.next(rows)) {
        // Column 0 is _id, 1 is name, 2 is age
        let name: string = db.col(rows, 1)
        let age: int = db.col(rows, 2)
        fmt.println(name)
        fmt.println(age)
    }

    db.free(rows)
    db.close(conn)
}
