import "fmt"
import "db"
import "str"

struct Person {
    id: long
    name: string
    age: int
}

fn main(): void {
    let conn: int = db.open("sqlite", "/tmp/dexprepared.db")
    assert(conn != -1)

    db.exec(conn, "DROP TABLE IF EXISTS people")
    db.exec(conn, "CREATE TABLE people (id INTEGER, name TEXT, age INTEGER, score REAL, active INTEGER)")

    let ins: int = db.prepare(conn, "INSERT INTO people VALUES (?, ?, ?, ?, ?)")
    assert(ins != -1)
    db.bindInt(ins, 1, 1)
    db.bindStr(ins, 2, "O'Brien; DROP TABLE people; --")
    db.bindInt(ins, 3, 44)
    db.bindDouble(ins, 4, 1.5)
    db.bindInt(ins, 5, 1)
    db.step(ins)
    db.finalize(ins)

    let ins2: int = db.prepare(conn, "INSERT INTO people VALUES (?, ?, ?, ?, ?)")
    let i: int = 2
    while (i <= 4) {
        db.reset(ins2)
        db.bindInt(ins2, 1, i)
        db.bindStr(ins2, 2, "p" + str.fromInt(i))
        db.bindInt(ins2, 3, 30 + i)
        db.bindDouble(ins2, 4, 0.5)
        db.bindInt(ins2, 5, 0)
        db.step(ins2)
        i = i + 1
    }
    db.finalize(ins2)

    let big: int = db.prepare(conn, "INSERT INTO people VALUES (?, ?, ?, ?, ?)")
    db.bindLong(big, 1, 9007199254740993)
    db.bindStr(big, 2, "huge")
    db.bindInt(big, 3, 50)
    db.bindDouble(big, 4, 0.0)
    db.bindInt(big, 5, 0)
    db.step(big)
    db.finalize(big)

    let lookup: int = db.prepare(conn, "SELECT id, name FROM people WHERE id = ?")
    db.bindLong(lookup, 1, 9007199254740993)
    assert(db.step(lookup))
    let bigId: long = db.col(lookup, 0)
    let bigName: string = db.col(lookup, 1)
    assert(bigId == 9007199254740993)
    assert(bigName == "huge")
    db.finalize(lookup)
    db.exec(conn, "DELETE FROM people WHERE id = 9007199254740993")

    // Every reader, against a statement handle.
    let one: int = db.prepare(conn, "SELECT id, name, age, score, active FROM people WHERE id = ?")
    db.bindInt(one, 1, 1)
    assert(db.step(one))
    let id: long = db.col(one, 0)
    let name: string = db.col(one, 1)
    let age: int = db.col(one, 2)
    let score: double = db.col(one, 3)
    let active: bool = db.col(one, 4)
    assert(id == 1)
    assert(name == "O'Brien; DROP TABLE people; --")
    assert(age == 44)
    assert(score == 1.5)
    assert(active)

    assert(!db.step(one))
    assert(!db.step(one))
    db.finalize(one)

    let sel: int = db.prepare(conn, "SELECT id, name, age FROM people WHERE age > ? ORDER BY id")
    db.bindInt(sel, 1, 31)
    let seen: int = 0
    while (db.next(sel)) {
        let p: Person = Person { id: 0, name: "seed", age: 0 }
        db.fill(p, sel)
        seen = seen + 1
        assert(p.id > 0)
        assert(p.age > 31)
        assert(!p.name.isEmpty())
    }
    // ages 44, 32, 33, 34 — every row is over 31
    assert(seen == 4)
    // free() on a statement handle finalizes it.
    db.free(sel)

    let gone: int = db.prepare(conn, "SELECT 7")
    db.finalize(gone)
    assert(db.col(gone, 0) == 0)
    assert(!db.step(gone))

    db.exec(conn, "DROP TABLE people")
    db.close(conn)
    fmt.println("prepared statements read their rows")
}
