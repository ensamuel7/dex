fn apply(f: fn(int): int, x: int): int {
    return f(x)
}

fn call0(f: fn(): string): string {
    return f()
}

fn makeAdder(n: int): fn(int): int {
    return fn(x: int): int {
        return x + n
    }
}

fn makeGreeter(name: string): fn(): string {
    return fn(): string {
        return "hello " + name
    }
}

fn main(): void {
    let base: int = 10
    let addBase: fn(int): int = fn(x: int): int {
        return x + base
    }
    assert(addBase(5) == 15)
    assert(apply(addBase, 1) == 11)

    let add7: fn(int): int = makeAdder(7)
    assert(add7(1) == 8)
    assert(add7(10) == 17)

    let greet: fn(): string = makeGreeter("dex")
    assert(greet() == "hello dex")
    assert(call0(greet) == "hello dex")

    let a: fn(int): int = makeAdder(1)
    let b: fn(int): int = makeAdder(100)
    assert(a(0) == 1)
    assert(b(0) == 100)

    let x: int = 2
    let y: int = 3
    let sum: fn(): int = fn(): int {
        return x + y
    }
    assert(sum() == 5)

    let f: fn(int): int = twice
    assert(f(21) == 42)
    assert(apply(twice, 4) == 8)
}

fn twice(x: int): int {
    return x * 2
}
