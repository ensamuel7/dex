import "http"
import "json"
import "os"
import "str"

fn echo(req: http.HttpRequest): http.HttpResponse {
    let body: string = json.encode({ method: req.method, path: req.path, query: req.query, body: req.body, auth: req.headers.get("authorization"), dup: req.headers.get("x-dup"), ctype: req.headers.get("content-type"), count: req.headers.len(), id: req.params.get("id") })
    return http.response(200, body, "application/json")
}

// Headers kept past the request they arrived on, and read on a later one.
let kept: map[string, string] = {}

fn keep(req: http.HttpRequest): http.HttpResponse {
    kept = req.headers
    return http.response(200, "{}", "application/json")
}

fn readKept(req: http.HttpRequest): http.HttpResponse {
    return http.response(200, json.encode({ keep: kept.get("x-keep"), has: kept.has("x-keep"), count: kept.len() }), "application/json")
}

// Every way to read the whole map: keys, values, has, len and json.encode.
fn allHeaders(req: http.HttpRequest): http.HttpResponse {
    let ks: string[] = req.headers.keys()
    let vs: string[] = req.headers.values()
    let out: string = json.encode(req.headers)
    let i: int = 0
    while (i < ks.len()) {
        out = out + "|" + ks[i] + "=" + vs[i]
        i = i + 1
    }
    if (req.headers.has("x-one")) {
        out = out + "|has"
    }
    return http.response(200, out, "text/plain")
}

fn cookies(req: http.HttpRequest): http.HttpResponse {
    let h: string = http.header("", "Set-Cookie", "a=1; Path=/")
    h = http.header(h, "Set-Cookie", "b=2")
    return http.responseWith(201, "{}", "", h)
}

fn ctype(req: http.HttpRequest): http.HttpResponse {
    if (req.query == "inject") {
        return http.response(200, "x", "text/plain\nX-Injected: 1")
    }
    let n: int = str.toInt(req.query)
    let ct: string = "text/"
    let i: int = 0
    while (i < n) {
        ct = ct + "a"
        i = i + 1
    }
    return http.response(200, "x", ct)
}

fn main(): void {
    http.route("GET", "/echo", echo)
    http.route("POST", "/echo", echo)
    http.route("GET", "/items/:id", echo)
    http.route("GET", "/cookies", cookies)
    http.route("GET", "/keep", keep)
    http.route("GET", "/kept", readKept)
    http.route("GET", "/headers", allHeaders)
    http.route("GET", "/ctype", ctype)
    let mode: string = os.env("MODE")
    if (mode == "uring") {
        http.uring()
    }
    if (mode == "inline") {
        http.inline()
    }
    http.limits(1024, 5, 0)
    http.listenOn("127.0.0.1", str.toInt(os.env("PORT")), 1)
}
