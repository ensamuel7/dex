import "http"
import "fmt"

const DEAD: string = "http://127.0.0.1:9/"

fn main(): void {
    let fast: http.HttpOptions = http.HttpOptions { timeoutMs: 300, connectTimeoutMs: 300 }
    let r: http.HttpResponse = http.requestWith("GET", DEAD, "", "", fast)

    assert(r.statusCode == 0)
    assert(!r.body.isEmpty())

    assert(r.contentType.isEmpty())
    assert(r.headers.isEmpty())
    assert(r.body.len() > 0)

    let plain: http.HttpOptions = http.HttpOptions {}
    assert(plain.timeoutMs == 0)
    assert(plain.connectTimeoutMs == 0)
    assert(plain.maxRedirects == 0)
    assert(!plain.insecureTls)

    let g: http.HttpResponse = http.get(DEAD)
    assert(g.statusCode == 0)
    assert(g.headers.isEmpty())
    assert(!g.body.isEmpty())

    let p: http.HttpResponse = http.post(DEAD, "{}")
    assert(p.statusCode == 0)
    assert(p.headers.isEmpty())

    let loose: http.HttpOptions = http.HttpOptions { insecureTls: true, timeoutMs: 300 }
    assert(loose.insecureTls)
    assert(loose.maxRedirects == 0)

    let l: http.HttpResponse = http.requestWith("GET", DEAD, "", "", loose)
    assert(l.statusCode == 0)

    fmt.println("http options: ok")
}
