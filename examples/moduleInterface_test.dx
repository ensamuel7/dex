import "fmt"
import "modules/alphaIface"
import "modules/betaIface"

struct Local {
    v: int

    fn run(): int {
        return v * 2
    }
}

fn main(): void {
    let a: alphaIface.Handler = alphaIface.make(41)
    let b: betaIface.Handler = betaIface.make("x")
    assert(a.run() == 42)
    assert(b.run() == "beta:x")

    let mine: alphaIface.Handler = Local { v: 21 }
    assert(mine.run() == 42)

    let all: alphaIface.Handler[] = [alphaIface.make(1), Local { v: 5 }]
    assert(all.len() == 2)
    assert(all[0].run() == 2)
    assert(all[1].run() == 10)

    fmt.println("module_interface_test: all assertions passed")
}
