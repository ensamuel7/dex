// Passwords and tokens: hashPassword, verifyPassword, randomHex.
import "fmt"
import "crypto"

fn main(): void {
    let stored: string = crypto.hashPassword("correct horse battery staple")
    assert(stored.startsWith("pbkdf2-sha256$600000$"))
    let parts: string[] = stored.split("$")
    assert(parts.len() == 4)
    assert(parts[2].len() == 32)
    assert(parts[3].len() == 64)

    assert(crypto.verifyPassword("correct horse battery staple", stored))
    assert(!crypto.verifyPassword("correct horse battery stapl", stored))
    assert(!crypto.verifyPassword("", stored))

    // A fresh salt each time: the same password never hashes the same.
    let again: string = crypto.hashPassword("correct horse battery staple")
    assert(again != stored)
    assert(crypto.verifyPassword("correct horse battery staple", again))

    // Anything malformed is a no, not a crash.
    assert(!crypto.verifyPassword("x", ""))
    assert(!crypto.verifyPassword("x", "plain"))
    assert(!crypto.verifyPassword("x", "pbkdf2-sha256$abc$00$00"))
    assert(!crypto.verifyPassword("x", "pbkdf2-sha256$600000$zz$00"))
    assert(!crypto.verifyPassword("x", "pbkdf2-sha256$600000$0011"))

    // A stored hash with no hash part is malformed too.
    assert(!crypto.verifyPassword("x", "pbkdf2-sha256$1000$00112233445566778899aabbccddeeff$"))

    let token: string = crypto.randomHex(32)
    assert(token.len() == 64)
    assert(token != crypto.randomHex(32))
    assert(crypto.randomHex(0) == "")

    fmt.println("crypto_password_test: all assertions passed")
}
