{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Dex",
  "scopeName": "source.dex",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#numbers" },
    { "include": "#struct-definition" },
    { "include": "#function-definition" },
    { "include": "#import-statement" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#builtins" },
    { "include": "#module-call" },
    { "include": "#function-call" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.dex",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.dex",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.dex",
              "match": "\\\\[\"\\\\nt0]"
            }
          ]
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "string.quoted.single.dex",
          "match": "'(\\\\[\"\\\\nt0']|[^'\\\\])'",
          "captures": {
            "0": { "name": "string.quoted.single.dex" }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.dex",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.dex",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "struct-definition": {
      "patterns": [
        {
          "match": "\\b(struct)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.struct.dex" },
            "2": { "name": "entity.name.type.struct.dex" }
          }
        }
      ]
    },
    "function-definition": {
      "patterns": [
        {
          "match": "\\b(fn|function)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.fn.dex" },
            "2": { "name": "entity.name.function.dex" }
          }
        }
      ]
    },
    "import-statement": {
      "patterns": [
        {
          "match": "\\b(import)\\s+(\"[^\"]*\")",
          "captures": {
            "1": { "name": "keyword.control.import.dex" },
            "2": { "name": "string.quoted.double.dex" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.dex",
          "match": "\\b(if|else|while|for|foreach|as|return|break|continue)\\b"
        },
        {
          "name": "keyword.other.fn.dex",
          "match": "\\b(fn|function)\\b"
        },
        {
          "name": "keyword.other.let.dex",
          "match": "\\b(let|const)\\b"
        },
        {
          "name": "keyword.control.import.dex",
          "match": "\\bimport\\b"
        },
        {
          "name": "keyword.other.struct.dex",
          "match": "\\bstruct\\b"
        },
        {
          "name": "keyword.other.access.dex",
          "match": "\\b(public|private)\\b"
        },
        {
          "name": "keyword.other.concurrency.dex",
          "match": "\\b(spawn)\\b"
        },
        {
          "name": "keyword.other.modifier.dex",
          "match": "\\b(weak)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.dex",
          "match": "\\b(int|long|double|char|bool|string|void)\\b"
        },
        {
          "name": "support.type.channel.dex",
          "match": "\\b(chan)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.dex",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.dex",
          "match": "\\b(assert|send|receive|channel|close)\\s*(?=\\()"
        }
      ]
    },
    "module-call": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\.([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.namespace.dex" },
            "2": { "name": "entity.name.function.dex" }
          }
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.dex" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.dex",
          "match": "===|!==|==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.dex",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.compound.dex",
          "match": "\\+=|-="
        },
        {
          "name": "keyword.operator.increment.dex",
          "match": "\\+\\+|--"
        },
        {
          "name": "keyword.operator.arithmetic.dex",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.assignment.dex",
          "match": "="
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.colon.dex",
          "match": ":"
        },
        {
          "name": "punctuation.separator.comma.dex",
          "match": ","
        },
        {
          "name": "punctuation.terminator.semicolon.dex",
          "match": ";"
        },
        {
          "name": "punctuation.accessor.dot.dex",
          "match": "\\."
        }
      ]
    }
  }
}
