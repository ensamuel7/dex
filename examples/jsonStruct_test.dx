import "json"
import "fmt"

struct Person {
    name: string
    age: int
    active: bool
}

struct Geo {
    lat: double
    lng: double
}

struct Address {
    city: string
    zip: int
    geo: Geo
}

struct Employee {
    name: string
    active: bool
    addr: Address
}

struct Item {
    label: string
    geo: Geo
}

struct Tag {
    id: int
    kind: string
}

struct Post {
    tag: string
    views: int[]
    names: string[]
    tags: Tag[]
}

fn main(): void {
    //Test json.encode with struct
    let p: Person = Person { name: "Alice", age: 30, active: true }
    let jsonStr: string = json.encode(p)
    fmt.println(jsonStr)

    //Test json.decode to parse JSON back to struct
    let p2: Person = json.decode(jsonStr)
    assert(p2.name == "Alice")
    assert(p2.age == 30)
    assert(p2.active == true)
    fmt.println(p2.name)
    fmt.println(p2.age)

    //Test decoding a document built as a json.Value
    let built: json.Value = { name: "Bob", age: 25, active: false }
    let raw: string = json.encode(built)
    let p3: Person = json.decode(raw)
    assert(p3.name == "Bob")
    assert(p3.age == 25)
    assert(p3.active == false)

    //Test round-trip
    let jsonStr2: string = json.encode(p3)
    let p4: Person = json.decode(jsonStr2)
    assert(p4.name == "Bob")
    assert(p4.age == 25)
    assert(p4.active == false)

    let home: Address = Address { city: "Lagos", zip: 100001, geo: Geo { lat: 6.5, lng: 3.4 } }
    let emp: Employee = Employee { name: "Zoe", active: true, addr: home }

    let encoded: string = json.encode(emp)
    let decoded: Employee = json.decode(encoded)
    assert(decoded.name == "Zoe")
    assert(decoded.active == true)
    assert(decoded.addr.city == "Lagos")
    assert(decoded.addr.zip == 100001)
    assert(decoded.addr.geo.lat == 6.5)
    assert(decoded.addr.geo.lng == 3.4)

    //Nested decode from hand-written JSON
    let handRaw: string =
        "{\"name\":\"Ada\",\"active\":false,\"addr\":{\"city\":\"Accra\",\"zip\":233,\"geo\":{\"lat\":5.6,\"lng\":0.2}}}"
    let hand: Employee = json.decode(handRaw)
    assert(hand.name == "Ada")
    assert(hand.addr.city == "Accra")
    assert(hand.addr.zip == 233)
    assert(hand.addr.geo.lat == 5.6)

    let partial: Employee = json.decode("{\"name\":\"Bo\",\"active\":true}")
    assert(partial.name == "Bo")
    assert(partial.addr.zip == 0)
    assert(partial.addr.city == "")

    //Nested structs inside struct arrays
    let items: Item[] =
        [Item { label: "a", geo: Geo { lat: 1.5, lng: 2.5 } }, Item { label: "b", geo: Geo { lat: 3.5, lng: 4.5 } }]
    let arrJson: string = json.encode(items)
    assert(
        arrJson ==
        "[{\"label\":\"a\",\"geo\":{\"lat\":1.5,\"lng\":2.5}},{\"label\":\"b\",\"geo\":{\"lat\":3.5,\"lng\":4.5}}]"
    )

    let wrapped: json.Value = { items: items }
    assert(
        json.encode(wrapped["items"]) ==
        "[{\"label\":\"a\",\"geo\":{\"lat\":1.5,\"lng\":2.5}},{\"label\":\"b\",\"geo\":{\"lat\":3.5,\"lng\":4.5}}]"
    )

    let okDec: Person? = json.decode("{\"name\":\"Ivy\",\"age\":31,\"active\":true}")
    assert(okDec != null)
    if (okDec != null) {
        assert(okDec.name == "Ivy")
        assert(okDec.age == 31)
    }

    let missing: Person? = json.decode("{\"name\":\"Jo\"}")
    assert(missing != null)
    if (missing != null) {
        assert(missing.name == "Jo")
        assert(missing.age == 0)
    }

    let nulled: Person? = json.decode("{\"name\":null,\"age\":5}")
    assert(nulled != null)
    if (nulled != null) {
        assert(nulled.name == "")
        assert(nulled.age == 5)
    }

    let bad1: Person? = json.decode("hello world")
    assert(bad1 == null)
    let bad2: Person? = json.decode("")
    assert(bad2 == null)
    let bad3: Person? = json.decode("{\"name\":\"Kai\"")
    assert(bad3 == null)
    let bad4: Person? = json.decode("{\"name\":42}")
    assert(bad4 == null)
    let bad5: Person? = json.decode("{\"age\":\"not-a-number\"}")
    assert(bad5 == null)

    //Checked decode recurses into nested structs too
    let deepOk: Employee? = json.decode(handRaw)
    assert(deepOk != null)
    if (deepOk != null) {
        assert(deepOk.addr.geo.lat == 5.6)
    }
    let deepBad: Employee? = json.decode("{\"name\":\"Ada\",\"addr\":{\"zip\":\"nope\"}}")
    assert(deepBad == null)

    //The non-optional target keeps its lenient behaviour
    let lenient: Person = json.decode("garbage")
    assert(lenient.name == "")
    assert(lenient.age == 0)

    let arrRaw: string =
        "[{\"label\":\"a\",\"geo\":{\"lat\":1.5,\"lng\":2.5}},{\"label\":\"b\",\"geo\":{\"lat\":3.5,\"lng\":4.5}}]"
    let decodedItems: Item[] = json.decode(arrRaw)
    let itemCount: int = decodedItems.len()
    assert(itemCount == 2)
    let it0: Item = decodedItems[0]
    let it1: Item = decodedItems[1]
    assert(it0.label == "a")
    assert(it0.geo.lat == 1.5)
    assert(it1.label == "b")
    assert(it1.geo.lng == 4.5)

    //Round-trips back through encode (which spaces after colons)
    assert(
        json.encode(decodedItems) ==
        "[{\"label\":\"a\",\"geo\":{\"lat\":1.5,\"lng\":2.5}},{\"label\":\"b\",\"geo\":{\"lat\":3.5,\"lng\":4.5}}]"
    )

    let emptyItems: Item[] = json.decode("[]")
    let emptyCount: int = emptyItems.len()
    assert(emptyCount == 0)

    //Checked struct array decode
    let okArr: Item[]? = json.decode(arrRaw)
    assert(okArr != null)
    if (okArr != null) {
        let okCount: int = okArr.len()
        assert(okCount == 2)
    }
    let notArr: Item[]? = json.decode("{\"label\":\"a\"}")
    assert(notArr == null)
    let badArr: Item[]? = json.decode("garbage")
    assert(badArr == null)
    let badElem: Item[]? = json.decode("[{\"label\":\"a\"},{\"label\":99}]")
    assert(badElem == null)
    let truncArr: Item[]? = json.decode("[{\"label\":\"a\"}")
    assert(truncArr == null)

    let ids: int[] = [7, 8]
    let ns: string[] = ["a", "b"]
    let tags: Tag[] = [Tag { id: 1, kind: "news" }, Tag { id: 2, kind: "tech" }]
    let ch: Post = Post { tag: "p1", views: ids, names: ns, tags: tags }

    let chJson: string = json.encode(ch)
    assert(
        chJson ==
        "{\"tag\":\"p1\",\"views\":[7,8],\"names\":[\"a\",\"b\"],\"tags\":[{\"id\":1,\"kind\":\"news\"},{\"id\":2,\"kind\":\"tech\"}]}"
    )

    let chBack: Post = json.decode(chJson)
    assert(chBack.tag == "p1")
    let cn: int = chBack.views.len()
    let nn: int = chBack.names.len()
    let pn: int = chBack.tags.len()
    assert(cn == 2)
    assert(nn == 2)
    assert(pn == 2)
    assert(chBack.views[1] == 8)
    assert(chBack.names[1] == "b")
    let port0: Tag = chBack.tags[0]
    assert(port0.id == 1)
    assert(port0.kind == "news")

    //Re-encoding is byte-identical
    assert(json.encode(chBack) == chJson)

    //An absent array key decodes to an empty array, not null
    let chPartial: Post = json.decode("{\"tag\":\"X\"}")
    let pc: int = chPartial.views.len()
    assert(pc == 0)

    fmt.println("json_struct_test: all assertions passed")
}
