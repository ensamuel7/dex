import "fmt"
import "reflect"
import "num"

struct Inner {
    label: string
    n: int
}

struct User {
    id: long
    email: string
    name: string
    score: double
    visits: int
    active: bool
    detail: Inner
}

struct Untouched {
    ignored: string
}

fn describe(c: &User): string {
    let sb = StringBuilder()
    let i: int = 0
    while (i < reflect.fieldCount(c)) {
        sb.append(reflect.fieldName(c, i))
        sb.append("=")
        sb.append(reflect.toString(c, i))
        sb.append(";")
        i = i + 1
    }

    return sb.toString()
}

fn main(): void {
    let unit: User = User {
        id: 42,
        email: "ada@example.com",
        name: "Ada Lovelace",
        score: 150.0,
        visits: 2,
        active: true,
        detail: Inner { label: "inner", n: 3 }
    }
    let other: Untouched = Untouched { ignored: "no metadata for this one" }

    fmt.println(reflect.typeName(unit))
    fmt.println(reflect.fieldCount(unit))

    let i: int = 0
    while (i < reflect.fieldCount(unit)) {
        fmt.println(reflect.fieldName(unit, i) + " (" + reflect.fieldKind(unit, i) + ") = " + reflect.toString(unit, i))
        i = i + 1
    }

    fmt.println(reflect.asString(unit, reflect.indexOf(unit, "email")))
    fmt.println(reflect.asLong(unit, 0))
    fmt.println(reflect.asDouble(unit, 3))
    fmt.println(reflect.asInt(unit, 4))
    fmt.println(reflect.asBool(unit, 5))
    fmt.println(reflect.has(unit, "name"))
    fmt.println(reflect.has(unit, "nope"))
    fmt.println(reflect.indexOf(unit, "nope"))

    // A name chosen at runtime searches the name table instead.
    let picked: string = "sco" + "re"
    fmt.println(reflect.asDouble(unit, reflect.indexOf(unit, picked)))

    fmt.println(reflect.asLong(unit, 1))
    fmt.println(reflect.asString(unit, 0))

    let names: string[] = reflect.fields(unit)
    fmt.println(names.len())
    fmt.println(names[1])

    fmt.println(reflect.typeName(unit.detail))
    fmt.println(reflect.asString(unit.detail, 0))
    fmt.println(reflect.toString(unit.detail, 1))
    let people: User[] = [unit]
    fmt.println(reflect.asString(people[0], 1))

    fmt.println(describe(unit))

    let total: long = 0
    let r: int = 0
    while (r < 500) {
        let f: int = 0
        while (f < reflect.fieldCount(unit)) {
            let shown: string = reflect.toString(unit, f)
            total = total + num.toLong(shown.len())
            f = f + 1
        }

        r = r + 1
    }

    fmt.println(total)
    fmt.println(other.ignored)
}
