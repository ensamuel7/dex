// Bound SQL parameters.
//
// Not a _test.dx file on purpose: it needs a live PostgreSQL, and the example
// suite has to run on a machine that has none.
//
//   go run . run examples/dbParams.dx

import "fmt"
import "db"
import "str"

fn main(): void {
    let conn: int = db.open("postgres", "host=localhost dbname=postgres")
    if (conn == -1) {
        fmt.println("no database — skipping")
        return
    }

    db.exec(conn, "CREATE TABLE IF NOT EXISTS people (id BIGSERIAL PRIMARY KEY, name TEXT, age BIGINT)")

    // Values travel beside the statement, never inside it. Postgres parses the
    // SQL once and treats every parameter as data, so the quote and the
    // statement terminator below are a name — not syntax.
    let insert: string[] = ["O'Brien; DROP TABLE people; --", "44"]
    db.execParams(conn, "INSERT INTO people (name, age) VALUES ($1, $2)", insert)

    // RETURNING comes back through the query path, like any other result.
    let second: string[] = ["Ada", "36"]
    let created: int = db.queryParams(conn,
        "INSERT INTO people (name, age) VALUES ($1, $2) RETURNING id", second)
    if (db.next(created)) {
        let id: int = db.col(created, 0)
        fmt.println("inserted id " + str.fromInt(id))
    }
    db.free(created)

    // Parameters are text, and the server infers each one's type from where it
    // sits — $1 here is compared against a bigint column.
    let older: string[] = ["40"]
    let rows: int = db.queryParams(conn, "SELECT name, age FROM people WHERE age > $1", older)
    while (db.next(rows)) {
        let name: string = db.col(rows, 0)
        let age: int = db.col(rows, 1)
        fmt.println(name + " is " + str.fromInt(age))
    }
    db.free(rows)

    // A statement with no parameters still works; pass an empty array.
    let none: string[] = []
    let counted: int = db.queryParams(conn, "SELECT count(*) FROM people", none)
    if (db.next(counted)) {
        let n: int = db.col(counted, 0)
        fmt.println(str.fromInt(n) + " rows")
    }
    db.free(counted)

    db.exec(conn, "DROP TABLE people")
    db.close(conn)
}
