import "fmt"

enum Color {
    Red
    Green
    Blue
}

enum Direction {
    North
    South
    East
    West
}

fn main(): void {
    let c: Color = Color.Red
    assert(c == Color.Red)
    assert(c != Color.Green)
    assert(c != Color.Blue)

    let g: Color = Color.Green
    assert(g == Color.Green)
    assert(g != Color.Red)

    if (c == Color.Red) {
        fmt.println("red")
    }

    assert(c != g)

    let d: Direction = Direction.East
    switch (d) {
        case Direction.North: {
            assert(false)
        }
        case Direction.East: {
            fmt.println("east")
        }
        case Direction.South, Direction.West: {
            assert(false)
        }
    }

    let c2: Color = Color.Blue
    switch (c2) {
        case Color.Red: {
            assert(false)
        }
        case Color.Green: {
            assert(false)
        }
        default: {
            fmt.println("blue")
        }
    }

    let mut: Color = Color.Red
    mut = Color.Blue
    assert(mut == Color.Blue)
    assert(mut != Color.Red)

    let colors: Color[] = []
    colors.push(Color.Red)
    colors.push(Color.Green)
    colors.push(Color.Blue)
    assert(colors.len() == 3)

    let first: Color = colors[0]
    assert(first == Color.Red)
    assert(colors[1] == Color.Green)
    assert(colors[2] == Color.Blue)

    colors.remove(1)
    assert(colors.len() == 2)
    assert(colors[0] == Color.Red)
    assert(colors[1] == Color.Blue)

    fmt.println("all enum tests passed")
}
