import "fmt"
import "db"

fn main(): void {
    let conn: int = db.open("mysql", "host=localhost user=root dbname=testdb")

    db.exec(conn, "CREATE TABLE IF NOT EXISTS users (id INT AUTO_INCREMENT PRIMARY KEY, name VARCHAR(100), age INT)")
    db.exec(conn, "INSERT INTO users (name, age) VALUES ('Alice', 30)")
    db.exec(conn, "INSERT INTO users (name, age) VALUES ('Bob', 25)")

    let rows: int = db.query(conn, "SELECT id, name, age FROM users")
    while (db.next(rows)) {
        let id: int = db.col(rows, 0)
        let name: string = db.col(rows, 1)
        let age: int = db.col(rows, 2)
        fmt.println(id)
        fmt.println(name)
        fmt.println(age)
    }

    db.free(rows)
    db.close(conn)
}
