// Generics: monomorphised type parameters on functions and structs.
//
// A generic declaration is a template, not code. Each distinct set of type
// arguments produces one concrete function or struct named after them —
// `max_int`, `Box_string` — so there is no boxing, no type metadata, and no
// dispatch at runtime: an instantiation is indistinguishable from the same code
// written out by hand.
//
// A function's type arguments are inferred from the call. A struct's are
// written, because a struct type has no arguments to infer them from.

import "fmt"

// --- Generic functions ---

fn identity<T>(x: T): T {
    return x
}

fn pick<T>(a: T, b: T, first: bool): T {
    if (first) {
        return a
    }
    return b
}

// Two type parameters, bound independently. Both are read: an unused parameter
// is a lint finding, and an example has to be clean.
fn describeTwo<A, B>(a: A, b: B): string {
    return "" + a + "/" + b
}

// Inference descends into a container: T comes from the element type.
fn firstElem<T>(xs: T[]): T {
    return xs[0]
}

// A generic calling a generic. The inner instantiation is built while the
// outer one's body is checked, which is why instantiation is a worklist rather
// than a single pass.
fn twice<T>(x: T): T {
    return identity(identity(x))
}

// --- Generic structs ---

struct Box<T> {
    value: T

    fn get(): T {
        return value
    }

    fn replace(v: T): T {
        self.value = v
        return self.value
    }
}

struct Pair<K, V> {
    key: K
    value: V

    fn describe(): string {
        return "pair"
    }
}

// A generic struct instantiated inside an ordinary function, with a type
// argument that owns heap memory.
fn wrap(label: string): string {
    let b: Box<string> = Box<string> { value: label }
    return b.get()
}

fn main(): void {
    // A type parameter binds to whatever the argument is.
    assert(identity(42) == 42)
    assert(identity("hi") == "hi")
    assert(identity(true) == true)
    assert(identity(3.5) == 3.5)

    // The same instantiation reused rather than rebuilt: both calls are
    // identity_int.
    assert(identity(1) == 1)
    assert(identity(2) == 2)

    // Several parameters of the same type parameter.
    assert(pick(1, 2, true) == 1)
    assert(pick("a", "b", false) == "b")

    // Independent type parameters: each binds from its own argument.
    assert(describeTwo(7, "s") == "7/s")
    assert(describeTwo("s", 9) == "s/9")
    assert(describeTwo(true, 2.5) == "true/2.5")

    // Inferred through an array.
    let nums: int[] = [10, 20, 30]
    assert(firstElem(nums) == 10)
    let strs: string[] = ["x", "y"]
    assert(firstElem(strs) == "x")

    // A generic that calls one.
    assert(twice(5) == 5)
    assert(twice("s") == "s")

    // A generic struct, two instantiations of the same template.
    let bi: Box<int> = Box<int> { value: 42 }
    assert(bi.get() == 42)
    assert(bi.replace(7) == 7)
    assert(bi.get() == 7)

    let bs: Box<string> = Box<string> { value: "held" }
    assert(bs.get() == "held")

    // A second Box<int> is the same type as the first, not a new one.
    let bi2: Box<int> = Box<int> { value: 1 }
    assert(bi2.get() == 1)

    // Two type parameters on a struct.
    let pr: Pair<string, int> = Pair<string, int> { key: "a", value: 2 }
    assert(pr.key == "a")
    assert(pr.value == 2)
    assert(pr.describe() == "pair")

    // A heap value in a generic field is owned exactly as in a written-out
    // struct: the instantiation is a real struct, so the release pass covers
    // it with no special case.
    let n = 5
    let built = "count-" + n
    let bh: Box<string> = Box<string> { value: built }
    assert(bh.get() == "count-5")
    assert(wrap("direct") == "direct")

    // A value built on the spot, so nothing else holds the string the box
    // takes a reference to.
    let temp: Box<string> = Box<string> { value: "t" + n }
    assert(temp.get() == "t5")

    fmt.println("generics ok")
}
