import "modules/grade"

// A qualified enum in a parameter type and a return type.
fn promote(b: grade.Band): grade.Band {
    if (b == grade.Band.Pass) {
        return grade.Band.Merit
    }
    return grade.Band.Distinction
}

fn main(): void {
    let b: grade.Band = grade.Band.Merit
    assert(grade.name(b) == "merit")
    assert(grade.points(b) == 2)

    switch (b) {
        case grade.Band.Pass: {
            assert(false)
        }
        case grade.Band.Merit, grade.Band.Distinction: {
            assert(true)
        }
        default: {
            assert(false)
        }
    }

    // Compared, passed, and returned.
    assert(promote(grade.Band.Pass) == grade.Band.Merit)
    assert(promote(grade.Band.Merit) == grade.Band.Distinction)
    assert(grade.best() == grade.Band.Distinction)

    // Held in an array, which needs the element type to resolve.
    let all: grade.Band[] = [grade.Band.Pass, grade.Band.Merit, grade.Band.Distinction]
    assert(all.len() == 3)
    let total: int = 0
    let i: int = 0
    while (i < all.len()) {
        total = total + grade.points(all[i])
        i = i + 1
    }
    assert(total == 6)

    let m: grade.Mark = grade.Mark { subject: "transport", band: grade.Band.Distinction }
    assert(grade.name(m.band) == "distinction")
    assert(m.subject == "transport")

    assert(grade.name(grade.best()) == "distinction")
}
