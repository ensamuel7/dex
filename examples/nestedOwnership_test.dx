// Ownership one level down: nested struct literals, struct array elements, and
// function values.
//
// Three regressions, all found by `DEX_MEM_CHECK=1`, none of them visible to
// `leaks`:
//
//  1. A returned struct literal whose *nested* field is itself a literal built
//     from borrowed locals. The retain pass asked whether the field value was
//     borrowed — a literal never is — and so retained nothing inside it, while
//     the release pass descended in and released everything. The function
//     returned a freed map and a freed array, and the caller's first write into
//     them hung the program.
//
//  2. A borrowed struct copied into an array literal. dex_array_struct_push is
//     a memcpy and takes no reference, but the array's destructor runs the
//     element cleanup over every slot — so the array and the original each
//     released the same strings.
//
//  3. A plain function used as a value. It is spelled as an identifier but
//     compiles to a fresh closure, so binding one retained a reference that
//     already stood alone, and passing one to a function that only borrows it
//     minted a reference nothing ever released.
//
// Every case loops hard, so a missing retain or a double release surfaces here
// rather than in whatever allocates next.

struct Cols {
    alias: string
    exprs: string[]
    at: map[string, int]

    fn named(field: string, column: string): void {
        exprs.push(alias + "." + column)
        at.set(field, exprs.len())
    }

    fn text(): string {
        let out: string = ""
        foreach (exprs as e) {
            if (out.isEmpty()) {
                out = e
            } else {
                out = out + ", " + e
            }
        }
        return out
    }
}

struct Select {
    source: string
    conds: string
    cols: Cols

    fn column(field: string, column: string): &Select {
        self.cols.named(field, column)
        return self
    }

    fn whereEq(field: string): &Select {
        self.conds = self.conds + " AND " + field + " = ?"
        return self
    }

    fn sql(): string {
        return "SELECT " + self.cols.text() + " FROM " + self.source + self.conds
    }
}

// The shape that found it: the nested Cols literal holds two locals this
// function is about to release, and the whole thing is returned.
fn newSelect(source: string, alias: string): Select {
    let at: map[string, int] = {}
    let exprs: string[] = []
    return Select { source: source, conds: "", cols: Cols { alias: alias, exprs: exprs, at: at } }
}

// Reading ordinals back out of the returned value, by value, through the nested
// field — so a freed map shows up as a wrong answer rather than as nothing.
fn ordinal(q: Select, field: string): int {
    return q.cols.at.get(field)
}

struct Row {
    email: string
    label: Cols
}

fn twice(x: int): int {
    return x * 2
}

fn apply(f: fn(int): int, v: int): int {
    return f(v)
}

fn main(): void {
    // 1. A nested literal returned across a scope boundary.
    let i: int = 0
    while (i < 200) {
        let q: Select = newSelect("invoices", "i")
        q.column("id", "id").column("name", "name").whereEq("i.org_id")
        assert(q.sql() == "SELECT i.id, i.name FROM invoices AND i.org_id = ?")
        assert(ordinal(q, "name") == 2)
        assert(q.cols.alias == "i")
        i = i + 1
    }

    // 2. A borrowed struct — with a nested struct of its own — into an array
    // literal, while the original stays alive and is read afterwards.
    let j: int = 0
    while (j < 200) {
        let at: map[string, int] = {}
        let exprs: string[] = ["r.label"]
        let unit: Row = Row {
            email: "ada@example.com",
            label: Cols { alias: "r", exprs: exprs, at: at }
        }
        let rows: Row[] = [unit]
        assert(rows.len() == 1)
        assert(rows[0].email == "ada@example.com")
        // The original is still the original, and still intact.
        assert(unit.email == "ada@example.com")
        assert(unit.label.exprs[0] == "r.label")
        j = j + 1
    }

    // 3. Function values, bound and passed.
    let k: int = 0
    while (k < 200) {
        let f: fn(int): int = twice
        assert(f(21) == 42)
        assert(apply(twice, 4) == 8)
        k = k + 1
    }
}
