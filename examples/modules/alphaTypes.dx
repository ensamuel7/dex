// One of two modules that each declare a `Response`. A type declared in a
// module belongs to it, the way a function does, so both can exist.
struct Response(ok: bool, label: string) {}

enum Kind {
    Fast
    Slow
}

fn make(label: string): Response {
    // Unqualified inside the module that declares it.
    return Response(true, label)
}

fn kindOf(r: Response): Kind {
    if (r.ok) {
        return Kind.Fast
    }
    return Kind.Slow
}
