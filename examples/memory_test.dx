import "str"

struct Item {
    label: string
    value: int
}

fn main(): void {
    let count = 0
    for (let i = 0; i < 10; i++) {
        let line: string = "iteration-" + str.fromInt(i)
        if (i % 2 == 0) {
            continue
        }
        count++
    }
    assert(count == 5)

    let found: string = ""
    let idx = 0
    while (idx < 5) {
        let candidate: string = "item-" + str.fromInt(idx)
        if (idx == 3) {
            found = candidate
            break
        }
        idx++
    }
    assert(found == "item-3")

    let item = Item { label: "hello", value: 42 }
    let name: string = item.label
    assert(name == "hello")

    let names: string[] = ["alpha", "beta", "gamma"]
    let picked: string = names[1]
    assert(picked == "beta")

    let tag: string = "initial"
    tag = item.label
    assert(tag == "hello")

    let sel: string = "start"
    sel = names[2]
    assert(sel == "gamma")

    let csv: string = ""
    for (let i = 0; i < 5; i++) {
        csv = csv + str.fromInt(i) + ","
    }
    assert(csv == "0,1,2,3,4,")

    let a: string = "hello"
    let b: string = " "
    let c: string = "world"
    let result: string = a + b + c + "!"
    assert(result == "hello world!")
}
