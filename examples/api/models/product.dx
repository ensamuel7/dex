import "json"

struct Product {
  id: int
  name: string
  price: double
  inStock: bool
}

fn info(): string {
  let response: string = json.new()
  response = json.set(response, "product", "Widget")
  return response
}

fn getAll(): string {
    let i: int = 0
    let products: Product[] = []

    while(i < 20) {
      let temp: Product = Product {
        id: i,
        name: "Product",
        price: 10.0,
        inStock: i % 2 == 0
      }

      products.push(temp)
      i++
    }

    let response: string = json.new()
    response = json.set(response, "products", products)
    return response
  }