// Filling a struct from a row: db.fill reads column i into field i.
//
// The point is that no field name is written twice. A row mapper written by
// hand names every field once in the struct and again in the mapper, and only
// the struct side is checked — so a renamed field, or a column inserted in the
// middle of a projection, goes wrong silently. Here the struct is the only
// place the shape is written down.
//
// Field order is column order, so the projection has to select one column per
// field in declaration order. A field reflection cannot read — the `tags`
// array below — is skipped but still consumes its column position, so the
// fields after it stay aligned.
//
// Not a _test.dx file: it needs a database. sqlite needs no server, so this one
// runs anywhere sqlite is linked.
//
//   go run . run examples/dbFill.dx

import "fmt"
import "db"
import "str"
import "reflect"

struct Person {
    id: long
    name: string
    age: int
    score: double
    active: bool
    tags: string[]
    note: string
}

fn main(): void {
    let conn: int = db.open("sqlite", "/tmp/dexfill.db")
    if (conn == -1) {
        fmt.println("no sqlite — skipping")
        return
    }
    db.exec(conn, "DROP TABLE IF EXISTS people")
    db.exec(
        conn,
        "CREATE TABLE people (id INTEGER, name TEXT, age INTEGER, score REAL, active INTEGER, tags TEXT, note TEXT)"
    )
    db.exec(conn, "INSERT INTO people VALUES (9007199254740993, 'Ada', 36, 1.5, 1, 'x,y', 'hello')")

    let r: int = 0
    while (r < 300) {
        let rows: int = db.query(conn, "SELECT id, name, age, score, active, tags, note FROM people")
        while (db.next(rows)) {
            let p: Person = Person { id: 0, name: "seed", age: 0, score: 0.0, active: false, tags: [], note: "seed" }
            db.fill(p, rows)
            // A long past 2^31 survives, which dex_db_col_int would not manage.
            assert(p.id == 9007199254740993)
            assert(p.name == "Ada")
            assert(p.age == 36)
            assert(p.score == 1.5)
            assert(p.active)
            assert(p.note == "hello")
            // The array field is skipped but still holds its column position,
            // so `note` after it is still right.
            assert(reflect.fieldKind(p, 5) == "array")
        }
        db.free(rows)
        r = r + 1
    }
    db.close(conn)
    fmt.println("300 rows filled, no field named twice")
}
