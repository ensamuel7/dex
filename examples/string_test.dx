fn main(): void {
    let s: string = "Hello, World"

    // len
    assert(s.len() == 12)

    // contains
    assert(s.contains("World") == true)
    assert(s.contains("xyz") == false)

    // startsWith / endsWith
    assert(s.startsWith("Hello") == true)
    assert(s.startsWith("World") == false)
    assert(s.endsWith("World") == true)
    assert(s.endsWith("Hello") == false)

    // indexOf
    assert(s.indexOf("World") == 7)
    assert(s.indexOf("xyz") == -1)

    // toLower / toUpper
    let lo: string = s.toLower()
    assert(lo == "hello, world")
    let up: string = s.toUpper()
    assert(up == "HELLO, WORLD")

    // trim
    let padded: string = "  hello  "
    let trimmed: string = padded.trim()
    assert(trimmed == "hello")

    // substring
    let sub: string = s.substring(0, 5)
    assert(sub == "Hello")

    // replace
    let r: string = s.replace("World", "Dex")
    assert(r == "Hello, Dex")

    // charAt
    let c: char = s.charAt(0)
    assert(c == 'H')

    // split
    let csv: string = "a,b,c"
    let parts: string[] = csv.split(",")
    assert(parts.len() == 3)
    assert(parts[0] == "a")
    assert(parts[1] == "b")
    assert(parts[2] == "c")

    // empty string edge cases
    let empty: string = ""
    assert(empty.len() == 0)
    assert(empty.contains("") == true)
    assert(empty.trim() == "")

    // A reading method's argument is released when the expression minted it.
    // Only a literal argument used to be, so every other way of producing one
    // leaked a reference per call. Looped so a missed release shows up here.
    let hay: string = "a-b-c"
    let mid: string = "b"
    let i: int = 0
    while (i < 2000) {
        assert(hay.indexOf("-" + mid + "-") == 1)
        assert(hay.startsWith(mid) == false)
        assert(hay.startsWith("a" + "-") == true)
        assert(hay.contains(hay.substring(0, 1)) == true)
        assert(hay.split("-" + "").len() == 3)
        // A plain variable is borrowed, and must not be released.
        assert(hay.indexOf(mid) == 2)
        i = i + 1
    }

    // A method whose receiver is an expression, used as a condition. An if or
    // while condition has no statement prelude to hoist the receiver into, and
    // this did not compile at all until the receiver was bound inline.
    let pieces: string[] = ["", "ab"]
    let seen: int = 0
    let k: int = 0
    while (k < 2000) {
        if (pieces[k % 2].isEmpty()) {
            seen = seen + 1
        }
        if (pieces[1].len() == 2) {
            seen = seen + 1
        }
        k = k + 1
    }
    assert(seen == 3000)
}
