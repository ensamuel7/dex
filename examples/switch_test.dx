fn main(): void {
    // Integer switch
    let x: int = 2
    let result: int = 0

    switch (x) {
        case 1: {
            result = 10
        }
        case 2: {
            result = 20
        }
        case 3: {
            result = 30
        }
        default: {
            result = -1
        }
    }
    assert(result == 20)

    // String switch
    let action: string = "Heartbeat"
    let handled: int = 0

    switch (action) {
        case "BootNotification": {
            handled = 1
        }
        case "Heartbeat", "StatusNotification": {
            handled = 2
        }
        default: {
            handled = -1
        }
    }
    assert(handled == 2)

    // Default case
    let unknown: string = "Unknown"
    let fallback: int = 0

    switch (unknown) {
        case "A": {
            fallback = 1
        }
        default: {
            fallback = 99
        }
    }
    assert(fallback == 99)

    // Char switch
    let grade: char = 'B'
    let score: int = 0

    switch (grade) {
        case 'A': {
            score = 100
        }
        case 'B': {
            score = 85
        }
        case 'C': {
            score = 70
        }
    }
    assert(score == 85)
}
