// DexLang Array Webserver Performance Test
// Build: dex build examples/webserver_arrays.dx
// Run:   ./webserver_arrays
// Test:  curl http://localhost:8080/items
//        curl http://localhost:8080/users
//
// Benchmark:
//   wrk -t4 -c100 -d10s http://localhost:8080/items
//   wrk -t4 -c100 -d10s http://localhost:8080/users

import "http"
import "json"
import "fmt"

// Native array path: builds 1000 ints via push, returns via json.setArray
fn handle_items(): string {
    let nums: int[] = []
    let i: int = 0
    while (i < 1000) {
        nums.push(i)
        i = i + 1
    }
    let response: string = json.new()
    response = json.set(response, "count", nums.len())
    response = json.setArray(response, "items", nums)
    return response
}

// Manual JSON path: builds 100 "user" objects via json.new/set + string concat
fn handle_users(): string {
    let result: string = "{\"users\": ["
    let i: int = 0
    while (i < 100) {
        if (i > 0) {
            result = result + ", "
        }
        let user: string = json.new()
        user = json.set(user, "name", "user")
        user = json.set(user, "id", i)
        user = json.set(user, "active", true)
        result = result + user
        i = i + 1
    }
    result = result + "]}"
    return result
}

fn main(): void {
    fmt.print("Routes:")
    fmt.print("  GET /items  - 1000 ints via native array + json.setArray")
    fmt.print("  GET /users  - 100 objects via json.new/set + string concat")
    http.route("GET", "/items", "handle_items")
    http.route("GET", "/users", "handle_users")
    http.listen(8080)
}
