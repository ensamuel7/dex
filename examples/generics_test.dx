import "fmt"

fn identity<T>(x: T): T {
    return x
}

fn pick<T>(a: T, b: T, first: bool): T {
    if (first) {
        return a
    }
    return b
}

fn describeTwo<A, B>(a: A, b: B): string {
    return "" + a + "/" + b
}

fn firstElem<T>(xs: T[]): T {
    return xs[0]
}

fn twice<T>(x: T): T {
    return identity(identity(x))
}

struct Box<T> {
    value: T

    fn get(): T {
        return value
    }

    fn replace(v: T): T {
        self.value = v
        return self.value
    }
}

struct Pair<K, V> {
    key: K
    value: V

    fn describe(): string {
        return "pair"
    }
}

fn wrap(label: string): string {
    let b: Box<string> = Box<string> { value: label }
    return b.get()
}

fn main(): void {
    assert(identity(42) == 42)
    assert(identity("hi") == "hi")
    assert(identity(true) == true)
    assert(identity(3.5) == 3.5)

    assert(identity(1) == 1)
    assert(identity(2) == 2)

    assert(pick(1, 2, true) == 1)
    assert(pick("a", "b", false) == "b")

    assert(describeTwo(7, "s") == "7/s")
    assert(describeTwo("s", 9) == "s/9")
    assert(describeTwo(true, 2.5) == "true/2.5")

    let nums: int[] = [10, 20, 30]
    assert(firstElem(nums) == 10)
    let strs: string[] = ["x", "y"]
    assert(firstElem(strs) == "x")

    assert(twice(5) == 5)
    assert(twice("s") == "s")

    let bi: Box<int> = Box<int> { value: 42 }
    assert(bi.get() == 42)
    assert(bi.replace(7) == 7)
    assert(bi.get() == 7)

    let bs: Box<string> = Box<string> { value: "held" }
    assert(bs.get() == "held")

    let bi2: Box<int> = Box<int> { value: 1 }
    assert(bi2.get() == 1)

    let pr: Pair<string, int> = Pair<string, int> { key: "a", value: 2 }
    assert(pr.key == "a")
    assert(pr.value == 2)
    assert(pr.describe() == "pair")

    let n = 5
    let built = "count-" + n
    let bh: Box<string> = Box<string> { value: built }
    assert(bh.get() == "count-5")
    assert(wrap("direct") == "direct")

    let temp: Box<string> = Box<string> { value: "t" + n }
    assert(temp.get() == "t5")

    fmt.println("generics ok")
}
