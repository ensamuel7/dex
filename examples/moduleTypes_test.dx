import "modules/alphaTypes"
import "modules/betaTypes"

struct Response {
    mine: int
}

fn main(): void {
    let local: Response = Response { mine: 7 }
    assert(local.mine == 7)

    let a: alphaTypes.Response = alphaTypes.make("first")
    let b: betaTypes.Response = betaTypes.make(404)
    assert(a.ok)
    assert(a.label == "first")
    assert(b.code == 404)

    assert(alphaTypes.kindOf(a) == alphaTypes.Kind.Fast)
    assert(betaTypes.kindOf(b) == betaTypes.Kind.Red)

    let direct: betaTypes.Response = betaTypes.Response(500)
    assert(direct.code == 500)

    let lit: alphaTypes.Response = alphaTypes.Response { ok: false, label: "lit" }
    assert(!lit.ok)
    assert(lit.label == "lit")
}
