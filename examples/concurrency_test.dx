fn multiply2(n: int): int {
    return n * 2
}

fn main(): void {
    let t1 = spawn {
        send(42)
    }
    assert(receive(t1) == 42)

    let t2 = spawn multiply2(21)
    assert(receive(t2) == 42)

    let ch = channel(int)
    for (let i = 0; i < 5; i++) {
        spawn {
            send(ch, i * 10)
        }
    }
    let total = 0
    for (let i = 0; i < 5; i++) {
        total += receive(ch)
    }
    assert(total == 100)

    spawn {
        multiply2(1)
    }
}
