import "fmt"

fn guarded(s: string): bool {
    if (!s.isEmpty() && s.substring(0, 1).toLower() == "a") {
        return true
    }
    return false
}

fn guardedOr(s: string): bool {
    if (s.isEmpty() || s.substring(0, 1).toLower() == "a") {
        return true
    }
    return false
}

fn main(): void {
    assert(guarded("Apple"))
    assert(!guarded("pear"))
    assert(!guarded(""))
    assert(guardedOr(""))
    assert(guardedOr("Apple"))
    assert(!guardedOr("pear"))

    // The comparison still works in every other position.
    let s: string = "  Hello  "
    assert(s.trim() == "Hello")
    assert(s.trim() != "hello")
    assert(s.trim().toLower() == "hello")
    assert("Hello" == s.trim())
    assert(("x" + "y") == "xy")
    let n: int = 0
    while (s.trim() != "done" && n < 3) {
        n = n + 1
    }
    assert(n == 3)
    fmt.println("string compare: ok")
}
